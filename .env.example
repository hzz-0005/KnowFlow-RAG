APP_NAME=KnowFlow RAG
APP_ENV=development
DATABASE_URL=postgresql+psycopg://knowflow:knowflow@localhost:5433/knowflow
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=60
MAX_UPLOAD_MB=20
UPLOAD_DIR=./data/uploads
PDF_PARSER=native
DOCLING_BASE_URL=http://localhost:5001
DOCLING_TIMEOUT_SECONDS=600
PDF_MAX_PAGES=150
PARSE_ARTIFACT_REVISION=docling-cpu-8ff0fd9379a7-adapter-v2

# Complete embedding input, including section/caption context. Offline Qwen3
# family tokenizer is an estimate for the hosted model; reserve a safety margin.
CHUNKING_STRATEGY=structure_tokens
CHUNK_MAX_TOKENS=512
CHUNK_TARGET_TOKENS=384
CHUNK_OVERLAP_TOKENS=48
CHUNK_TOKEN_RESERVE=16
# Optional local tokenizer.json; never downloaded at runtime.
CHUNK_TOKENIZER_PATH=

# Qwen3.7 flagship text embedding. API keys belong in your local .env file.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=2560

# Primary and complex tasks share a Qwen key; credentials stay local.
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
LLM_COMPLEX_MODEL=qwen3.8-max
LLM_SIMPLE_THINKING=disabled
LLM_COMPLEX_THINKING=enabled
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=60

# Optional independent evaluation judge. Empty fields reuse the chat model;
# reports explicitly disclose same-model self-evaluation and unknown results.
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_BASE_URL=https://api.deepseek.com
# Full model version currently DeepSeek-V4.1-Flash-1017; the API ID is deepseek-flash.
EVAL_JUDGE_MODEL=deepseek-flash
EVAL_JUDGE_THINKING=enabled
EVAL_JUDGE_TIMEOUT_SECONDS=90
STRUCTURED_MIMO_THINKING=disabled

# Optional reranker; for Qwen 3.7 use the Model Studio text-rerank endpoint.
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=qwen3.7-text-rerank
RERANK_INSTRUCTION=Given a question, rank passages by how well they answer the question.

RAG_MAX_COSINE_DISTANCE=0.35
RAG_TOP_K=5
RAG_CONTEXT_TOKEN_BUDGET=6000
# Answer-stage operational budget. Local token counts are estimates, not provider limits.
RAG_ANSWER_TOTAL_TOKEN_BUDGET=32768
RAG_ANSWER_OUTPUT_TOKEN_BUDGET=8192
RAG_ANSWER_SAFETY_TOKENS=1024
# auto: documented Qwen3.7/3.8 and MiMo2.6 use max_completion_tokens;
# DeepSeek uses max_tokens. Other compatible providers are marked unverified.
RAG_ANSWER_OUTPUT_PARAMETER=auto
RETRIEVAL_ASSESSMENT_ENABLED=true
TABLE_ROW_RETRIEVAL_ENABLED=true
REFERENCE_EXPANSION_ENABLED=true
RETRIEVAL_ASSESSMENT_TOKEN_BUDGET=12000
# Relevance-stage operational target, estimated full prompt + output + safety.
RETRIEVAL_ASSESSMENT_TOTAL_TOKEN_BUDGET=32768
RETRIEVAL_ASSESSMENT_OUTPUT_TOKEN_BUDGET=4096
RETRIEVAL_ASSESSMENT_SAFETY_TOKENS=1024
RETRIEVAL_ASSESSMENT_OUTPUT_PARAMETER=auto
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_TIMEOUT_SECONDS=15
ANSWER_GUARD_ENABLED=true
# All audit inputs are preserved; no request when full prompt exceeds this target.
ANSWER_REVIEW_TOTAL_TOKEN_BUDGET=32768
ANSWER_REVIEW_OUTPUT_TOKEN_BUDGET=8192
ANSWER_REVIEW_SAFETY_TOKENS=1024
ANSWER_REVIEW_OUTPUT_PARAMETER=auto
ANSWER_REPAIR_TOTAL_TOKEN_BUDGET=32768
ANSWER_REPAIR_OUTPUT_TOKEN_BUDGET=4096
ANSWER_REPAIR_SAFETY_TOKENS=1024
ANSWER_REPAIR_OUTPUT_PARAMETER=auto
ANSWER_GUARD_TIMEOUT_SECONDS=75


# Separate bounded stemming candidates; base top-k metrics exclude additions.
ENGLISH_KEYWORD_RETRIEVAL_ENABLED=true

ANSWER_REPAIR_ENABLED=true
ANSWER_REPAIR_TIMEOUT_SECONDS=15

# Interactive request deadline; nginx allows 210 s for the final status.
QUERY_TIMEOUT_SECONDS=180

# Interactive guard only; offline EVAL_JUDGE_THINKING stays independent.
ANSWER_GUARD_THINKING=enabled

# Summary-only operational window; these are local budgets, not provider guarantees.
RAG_SUMMARY_CONTEXT_TOKEN_BUDGET=48000
RAG_SUMMARY_TOTAL_TOKEN_BUDGET=65536
RAG_SUMMARY_OUTPUT_TOKEN_BUDGET=4096
