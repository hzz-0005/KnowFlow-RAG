{
  "schema": "knowflow.integrity-controls.v2",
  "contract": "persisted-integrity-v2 + source-consistency-v1",
  "scope": "Synthetic software controls; not parser accuracy, semantic gold, or generalization evidence.",
  "changes_from_v1": "semantic_blind_spot (same-length replacement) is now DETECTED as source_excerpt_mismatch/error. The v1 frozen contract stays reproducible with --contract v1; this file must not be back-edited into v1.",
  "cases": [
    {"id":"clean_md","source":"flow.md","mutation":"none","role":"negative_control","forbid_severities":["error"],"forbid_codes":["source_excerpt_layout_mismatch"]},
    {"id":"clean_docx","source":"flow.docx","mutation":"none","role":"negative_control","forbid_severities":["error"],"forbid_codes":["source_excerpt_layout_mismatch"]},
    {"id":"clean_csv","source":"service-control.csv","mutation":"none","role":"negative_control","forbid_severities":["error"],"forbid_codes":["source_excerpt_mismatch","source_excerpt_layout_mismatch"],"note":"Spreadsheet spans carry cell ranges without character mapping; consistency stays not_comparable."},
    {"id":"clean_xlsx","source":"inventory-control.xlsx","mutation":"none","role":"negative_control","forbid_severities":["error"],"forbid_codes":["source_excerpt_mismatch","source_excerpt_layout_mismatch"]},
    {"id":"clean_unicode","source":"unicode-flow.md","mutation":"none","role":"negative_control","forbid_severities":["error"],"forbid_codes":["source_excerpt_mismatch","source_excerpt_layout_mismatch"],"note":"CJK and decomposable Latin characters must not create false positives."},
    {"id":"same_length_replacement","source":"flow.md","mutation":"same_length_replacement","role":"fault_control","expect_code":"source_excerpt_mismatch","expect_severity":"error","forbid_codes":["source_excerpt_layout_mismatch"],"note":"v1 semantic_blind_spot: same-length unrelated text with legal coordinates is now detected."},
    {"id":"caption_layout_replacement","source":"flow.md","mutation":"caption_layout_replacement","role":"boundary_control","expect_code":"source_excerpt_layout_mismatch","expect_severity":"warning","forbid_codes":["source_excerpt_mismatch"],"note":"Caption/table-layout blocks: string divergence is a warning (layout reflow or OCR cleaning may be legal), never a proven error."},
    {"id":"whitespace_rewrite","source":"flow.md","mutation":"whitespace_rewrite","role":"boundary_control","expect_code":"source_excerpt_normalized","expect_severity":"info","forbid_codes":["source_excerpt_mismatch","source_excerpt_layout_mismatch"],"note":"Whitespace/newline differences are a documented normalization, not an error."},
    {"id":"unicode_form","source":"unicode-flow.md","mutation":"unicode_form","role":"boundary_control","expect_code":"source_excerpt_normalized","expect_severity":"info","forbid_codes":["source_excerpt_mismatch","source_excerpt_layout_mismatch"],"note":"NFC vs NFD of the same text normalizes equal."},
    {"id":"partial_coverage","source":"flow.md","mutation":"partial_coverage","role":"boundary_control","forbid_severities":["error"],"forbid_codes":["source_excerpt_mismatch","source_excerpt_layout_mismatch"],"note":"A source range covering only part of the excerpt must not be compared against the whole chunk."},
    {"id":"cross_page_spans","source":"flow.md","mutation":"cross_page_spans","role":"boundary_control","forbid_severities":["error"],"forbid_codes":["source_excerpt_mismatch","source_excerpt_layout_mismatch"],"note":"Multi-page spans are compared per span; page splitting alone is not a mismatch."},
    {"id":"section_prefix","source":"flow.md","mutation":"section_prefix","role":"boundary_control","forbid_severities":["error"],"forbid_codes":["source_excerpt_mismatch","source_excerpt_layout_mismatch"],"note":"The full-input section prefix is never treated as source excerpt."},
    {"id":"remove_chunk_range","source":"flow.md","mutation":"remove_chunk_range","role":"unknown_control","expect_code":"chunk_range_missing","expect_severity":"unknown","forbid_codes":["source_excerpt_mismatch","source_excerpt_layout_mismatch"]},
    {"id":"truncated_source_text","source":"flow.md","mutation":"truncated_source_text","role":"unknown_control","expect_code":"source_consistency_unknown","expect_severity":"unknown","forbid_codes":["source_excerpt_mismatch","source_excerpt_layout_mismatch"],"note":"Source text beyond the read budget stays unknown, never a guessed match."},
    {"id":"duplicate_context","source":"flow.md","mutation":"duplicate_context","role":"boundary_control","expect_code":"duplicate_content","expect_severity":"info","forbid_severities":["error"],"forbid_codes":["source_excerpt_layout_mismatch"],"note":"Repeated text stays consistent; duplicates are not deleted."},
    {"id":"missing_source","source":"flow.md","mutation":"missing_source","role":"fault_control","expect_code":"source_missing","expect_severity":"unknown"},
    {"id":"dangling_block","source":"flow.md","mutation":"dangling_block","role":"fault_control","expect_code":"dangling_block","expect_severity":"error"},
    {"id":"chunk_range","source":"flow.md","mutation":"chunk_range","role":"fault_control","expect_code":"invalid_chunk_range","expect_severity":"error"},
    {"id":"text_range","source":"flow.md","mutation":"text_range","role":"fault_control","expect_code":"invalid_text_range","expect_severity":"error"},
    {"id":"invalid_region","source":"flow.md","mutation":"invalid_region","role":"fault_control","expect_code":"invalid_bbox","expect_severity":"error"},
    {"id":"over_budget","source":"flow.md","mutation":"over_budget","role":"fault_control","expect_code":"token_over_budget","expect_severity":"error"},
    {"id":"bad_cell","source":"inventory-control.xlsx","mutation":"bad_cell","role":"fault_control","expect_code":"invalid_cell_location","expect_severity":"error"},
    {"id":"old_tokenizer","source":"flow.md","mutation":"old_tokenizer","role":"unknown_control","expect_code":"token_policy_unknown","expect_severity":"unknown","forbid_codes":["token_over_budget"]},
    {"id":"withheld_sources","source":"flow.md","mutation":"withheld_sources","role":"unknown_control","expect_code":"source_missing","expect_severity":"unknown","forbid_codes":["unreferenced_block","page_without_chunk_source"]},
    {"id":"partial_blocks","source":"flow.md","mutation":"partial_blocks","role":"unknown_control","expect_code":"inspection_incomplete","expect_severity":"unknown","forbid_codes":["dangling_block"]},
    {"id":"blank_page_projection","source":"flow.md","mutation":"blank_page_projection","role":"boundary_control","expect_code":"page_without_chunk_source","expect_severity":"warning","forbid_severities":["error"]}
  ]
}
